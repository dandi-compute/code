name: Build and upload LFP container image

# Building the pipeline container is expensive and rarely needs to happen, so it
# is triggered manually rather than on every push. Run it from the Actions tab or
# with `gh workflow run "Build and upload LFP container image"`.
on:
  workflow_dispatch:
    inputs:
      dockerfile:
        description: "Path to the Dockerfile to build."
        required: true
        default: "containers/lfp.Dockerfile"
      context:
        description: "Build context directory."
        required: true
        default: "."
      image:
        description: "Image name to publish under ghcr.io/<owner>/."
        required: true
        default: "dandi-compute-lfp"

permissions:
  contents: read
  packages: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  BuildAndPush:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7
